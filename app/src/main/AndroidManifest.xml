<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.battery" android:required="false"/>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="2%Power" android:icon="@android:drawable/ic_menu_info_details" android:allowBackup="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <receiver android:name=".PowerWidgetProvider" android:exported="true" android:label="2%Power">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/power_widget_info"/>
        </receiver>
    </application>
</manifest>
